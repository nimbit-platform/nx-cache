package web

import (
	"fmt"
	"strconv"

	"github.com/nimbit-platform/nx-cache/components/badge"
	"github.com/nimbit-platform/nx-cache/components/button"
	"github.com/nimbit-platform/nx-cache/components/card"
	"github.com/nimbit-platform/nx-cache/components/input"
	"github.com/nimbit-platform/nx-cache/components/table"
)

templ DashboardPage(data DashboardData) {
	@Layout("Remote cache · Nx Cache") {
		@Nav(data.Username, data.TTL)
		<main class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-4 py-6">
			<div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
				<div>
					<h1 class="font-heading text-2xl tracking-tight">Remote cache</h1>
					<p class="text-muted-foreground text-sm">S3-backed Nx artifacts, hit/miss stats, and 5-day retention.</p>
				</div>
				<form method="post" action="/ui/cleanup">
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline}) {
						Purge expired
					}
				</form>
			</div>
			if data.Message != "" {
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "w-fit"}) {
					{ data.Message }
				}
			}
			<div id="stats" hx-get="/ui/stats" hx-trigger="every 15s" hx-swap="outerHTML">
				@StatsSection(data)
			</div>
			@card.Card() {
				@card.Header(card.HeaderProps{Class: "border-b"}) {
					@card.Title() {
						Cached artifacts
					}
					@card.Description() {
						Search by hash. Age is time since the artifact was first stored.
					}
					@card.Action() {
						@input.Input(input.Props{
							Name:        "q",
							Value:       data.Query,
							Placeholder: "Filter hash…",
							Class:       "w-56",
							Attributes: templ.Attributes{
								"hx-get":         "/ui/entries",
								"hx-trigger":     "keyup changed delay:300ms, search",
								"hx-target":      "#entries",
								"hx-include":     "closest form, this",
								"hx-push-url":    "false",
							},
						})
					}
				}
				@card.Content(card.ContentProps{Class: "pt-0"}) {
					<div id="entries">
						@EntriesSection(data)
					</div>
				}
			}
		</main>
	}
}

templ StatsSection(data DashboardData) {
	<div id="stats" class="grid gap-4 md:grid-cols-4" hx-get="/ui/stats" hx-trigger="every 15s" hx-swap="outerHTML">
		@statCard("Artifacts", fmt.Sprintf("%d", data.Stats.Entries), "Objects currently in cache")
		@statCard("Storage", FormatBytes(data.Stats.TotalSize), "Total size on S3")
		@statCard("Hit rate", FormatRate(data.Stats), fmt.Sprintf("%d stores", data.Stats.Stores))
		@statCard("Hits / misses", fmt.Sprintf("%d / %d", data.Stats.Hits, data.Stats.Misses), "Nx GET outcomes")
		<div class="md:col-span-4">
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Cache hits vs misses
					}
					@card.Description() {
						Share of successful restores against 404 misses.
					}
				}
				@card.Content() {
					<div class="bg-muted flex h-3 overflow-hidden rounded-full">
						<div class="bg-emerald-500 h-full" style={ templ.SafeCSS(fmt.Sprintf("width: %.2f%%", data.HitBarWidth)) }></div>
						<div class="bg-rose-500 h-full" style={ templ.SafeCSS(fmt.Sprintf("width: %.2f%%", data.MissBarWidth)) }></div>
					</div>
					<div class="text-muted-foreground mt-3 flex gap-4 text-xs">
						<span class="flex items-center gap-1.5"><span class="bg-emerald-500 size-2 rounded-full"></span>Hits { fmt.Sprintf("%.1f%%", data.HitBarWidth) }</span>
						<span class="flex items-center gap-1.5"><span class="bg-rose-500 size-2 rounded-full"></span>Misses { fmt.Sprintf("%.1f%%", data.MissBarWidth) }</span>
					</div>
				}
			}
		</div>
	</div>
}

templ statCard(title, value, hint string) {
	@card.Card() {
		@card.Header() {
			@card.Description() {
				{ title }
			}
			@card.Title(card.TitleProps{Class: "text-2xl tabular-nums"}) {
				{ value }
			}
		}
		@card.Content() {
			<p class="text-muted-foreground text-xs">{ hint }</p>
		}
	}
}

templ EntriesSection(data DashboardData) {
	if len(data.Entries) == 0 {
		<p class="text-muted-foreground py-10 text-center text-sm">No cache artifacts yet. Point Nx at this server and run a build.</p>
	} else {
		@table.Table() {
			@table.Header() {
				@table.Row() {
					@table.Head() {
						Hash
					}
					@table.Head() {
						Size
					}
					@table.Head() {
						Age
					}
					@table.Head() {
						Hits
					}
					@table.Head() {
						Last access
					}
				}
			}
			@table.Body() {
				for _, e := range data.Entries {
					@table.Row() {
						@table.Cell(table.CellProps{Class: "font-mono text-xs"}) {
							{ e.Hash }
						}
						@table.Cell() {
							{ e.Size }
						}
						@table.Cell() {
							{ e.Age }
						}
						@table.Cell(table.CellProps{Class: "tabular-nums"}) {
							{ strconv.FormatInt(e.Hits, 10) }
						}
						@table.Cell(table.CellProps{Class: "text-muted-foreground"}) {
							{ e.LastAccess }
						}
					}
				}
			}
		}
		if data.Pages > 1 {
			<div class="flex items-center justify-between py-4">
				<p class="text-muted-foreground text-xs">{ fmt.Sprintf("%d artifacts", data.Total) }</p>
				<div class="flex gap-2">
					if data.Page > 1 {
						@button.Button(button.Props{
							Variant: button.VariantOutline,
							Size:    button.SizeSm,
							Href:    fmt.Sprintf("/?q=%s&page=%d", data.Query, data.Page-1),
						}) {
							Previous
						}
					}
					if data.Page < data.Pages {
						@button.Button(button.Props{
							Variant: button.VariantOutline,
							Size:    button.SizeSm,
							Href:    fmt.Sprintf("/?q=%s&page=%d", data.Query, data.Page+1),
						}) {
							Next
						}
					}
				</div>
			</div>
		}
	}
}
