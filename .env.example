# Required
NX_CACHE_ACCESS_TOKEN=change-me
UI_USERNAME=admin
UI_PASSWORD=change-me
SESSION_SECRET=change-me-too
SESSION_SECURE=false

# S3 / RustFS / MinIO (artifacts + default catalog/stats)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=nxcache
AWS_SECRET_ACCESS_KEY=nxcache-e2e-secret-key
S3_BUCKET_NAME=nx-cache
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_PREFIX=nx-cache/
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true

# Optional
PORT=8080
STORAGE_BACKEND=s3
CATALOG_BACKEND=s3
CATALOG_FLUSH_INTERVAL=30s
# CATALOG_BACKEND=sqlite
# SQLITE_PATH=/data/nx-cache.db
CACHE_TTL=120h
CLEANUP_INTERVAL=1h
CLEANUP_ON_SAVE=true
# NX_CACHE_READ_TOKEN=
# TRUST_FORWARDED_IP=false
# ALLOW_IPS=10.0.0.0/8,192.168.1.4
# RATE_LIMIT_RPS=50
# RATE_LIMIT_BURST=100
# LOG_LEVEL=info
